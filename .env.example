# ===================================================================
#  KOSMITIK — قالب متغيّرات البيئة  (انسخه إلى .env.local واملأ القيم)
#  ملاحظة أمان: .env.local و .env.production لا تُرفع إلى git إطلاقاً.
#  انتبه: Next.js يُعطي .env.local أولوية أعلى من .env.production،
#  فلا تترك مفاتيح فارغة في .env.local تطغى على الحقيقية.
# ===================================================================

# --- Firebase (عامة — تُضمَّن في الواجهة، ليست سرّية) -----------------
# احصل عليها من: Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- المساعد الذكي (اختياري، OpenRouter) -----------------------------
# NEXT_PUBLIC_* لأنّ الاستدعاء من الواجهة (يعمل على الأهداف الثلاثة).
NEXT_PUBLIC_OPENROUTER_API_KEY=
NEXT_PUBLIC_OPENROUTER_MODEL=openai/gpt-4o-mini

# --- كلمة سر الصفحات المالية (اختياري، الافتراضي 1234) ----------------
NEXT_PUBLIC_APP_PASSWORD=

# --- إعداد Electron (الحاسوب فقط) ------------------------------------
# اسم الطابعة الحرارية (اكتشاف تلقائي إن تُرك فارغاً: xp/pos/80…)
POS_PRINTER_NAME=
